@page "/settings"
@using DotNetCorePatchNotifier.Models
@using DotNetCorePatchNotifier.Repositories
@using DotNetCorePatchNotifier.Services
@inject IServiceScopeFactory ScopeFactory

<h3>Settings</h3>

<p class="text-muted">
    Configure Windows and email notifications for .NET Core runtime patches.
</p>

@if (loading)
{
    <p>Loading settings...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
    <button class="btn btn-outline-primary" @onclick="LoadSettingsAsync">Retry</button>
}
else if (settings != null && emailSettings != null)
{
    <div class="card p-4 mt-3">
        <h5>Windows notifications</h5>

        <div class="form-check form-switch mt-3">
            <InputCheckbox class="form-check-input"
                           @bind-Value="settings.NotificationsEnabled"
                           disabled="@busy" />
            <label class="form-check-label">
                Notify me when a .NET Core runtime patch is available
            </label>
        </div>

        <hr class="my-4" />

        <h5>Email notifications</h5>

        <div class="form-check form-switch mt-3">
            <InputCheckbox class="form-check-input"
                           @bind-Value="emailSettings.Enabled"
                           disabled="@busy" />
            <label class="form-check-label">
                Send email when a new patch is available
            </label>
        </div>

        <div class="mt-3">
            <label class="form-label">Email provider</label>
            <InputSelect class="form-select"
                         @bind-Value="emailSettings.Provider"
                         disabled="@busy">
                <option value="Gmail">Gmail</option>
                <option value="SMTP">Custom SMTP</option>
            </InputSelect>
        </div>

        @if (emailSettings.Provider == "SMTP")
        {
            <div class="row mt-3">
                <div class="col-md-8">
                    <label class="form-label">SMTP server</label>
                    <InputText class="form-control"
                               @bind-Value="emailSettings.SmtpHost"
                               disabled="@busy" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Port</label>
                    <InputNumber class="form-control"
                                 @bind-Value="emailSettings.SmtpPort"
                                 disabled="@busy" />
                </div>
            </div>
        }
        else
        {
            <p class="text-muted small mt-3">
                Gmail: smtp.gmail.com, port 587.
                Use a Google App Password, not your normal password.
            </p>
        }

        <div class="mt-3">
            <label class="form-label">Sender email</label>
            <InputText class="form-control"
                       @bind-Value="emailSettings.SenderEmail"
                       disabled="@busy" />
        </div>

        <div class="mt-3">
            <label class="form-label">Recipient email</label>
            <InputText class="form-control"
                       @bind-Value="emailSettings.RecipientEmail"
                       disabled="@busy" />
        </div>

        <div class="mt-3">
            <label class="form-label">SMTP username</label>
            <InputText class="form-control"
                       @bind-Value="emailSettings.Username"
                       disabled="@busy" />
        </div>

        <div class="mt-3">
            <label class="form-label">
                SMTP password / Gmail App Password
            </label>
            <div class="form-text">
                Leave empty to keep your existing saved password.
                Saved passwords are not displayed for security reasons.
            </div>
            <input class="form-control"
                   type="password"
                   autocomplete="new-password"
                   @bind="password"
                   disabled="@busy" />
            <div class="form-text">
                Leave empty to keep the existing saved password.
                Passwords are stored using Windows secure storage.
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button class="btn btn-primary"
                    @onclick="SaveSettingsAsync"
                    disabled="@busy">
                @(busy ? "Please wait..." : "Save settings")
            </button>

            <button class="btn btn-outline-primary"
                    @onclick="SendTestEmailAsync"
                    disabled="@busy">
                Send test email
            </button>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-3">@successMessage</div>
        }

        @if (!string.IsNullOrEmpty(saveErrorMessage))
        {
            <div class="alert alert-danger mt-3">@saveErrorMessage</div>
        }
    </div>
}

@code {
    private const string PasswordKey = "DotNetCorePatchNotifier.SMTP.Password";

    private AppSettings? settings;
    private EmailSettings? emailSettings;
    private string password = string.Empty;
    private bool loading = true;
    private bool busy;

    private string? errorMessage;
    private string? saveErrorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        loading = true;
        errorMessage = null;
        saveErrorMessage = null;
        successMessage = null;

        try
        {
            using var scope = ScopeFactory.CreateScope();

            settings = await scope.ServiceProvider
                .GetRequiredService<IAppSettingsRepository>()
                .GetAsync();

            emailSettings = await scope.ServiceProvider
                .GetRequiredService<IEmailSettingsRepository>()
                .GetAsync();

            password = string.Empty;
        }
        catch (Exception ex)
        {
            settings = null;
            emailSettings = null;
            errorMessage = $"Unable to load settings: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (settings == null || emailSettings == null || busy)
            return;

        busy = true;
        successMessage = null;
        saveErrorMessage = null;

        try
        {
            using var scope = ScopeFactory.CreateScope();

            await scope.ServiceProvider
                .GetRequiredService<IAppSettingsRepository>()
                .SaveAsync(settings);

            await scope.ServiceProvider
                .GetRequiredService<IEmailSettingsRepository>()
                .SaveAsync(emailSettings);

            if (!string.IsNullOrWhiteSpace(password))
            {
                await SecureStorage.Default.SetAsync(PasswordKey, password);
                password = string.Empty;
            }

            successMessage = "Settings saved successfully.";
        }
        catch (Exception ex)
        {
            saveErrorMessage = $"Unable to save settings: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SendTestEmailAsync()
    {
        if (emailSettings == null || busy)
            return;

        busy = true;
        successMessage = null;
        saveErrorMessage = null;

        try
        {
            var currentPassword = !string.IsNullOrWhiteSpace(password)
                ? password
                : await SecureStorage.Default.GetAsync(PasswordKey);

            if (string.IsNullOrWhiteSpace(currentPassword))
                throw new InvalidOperationException("Enter your SMTP password or Gmail App Password.");

            using var scope = ScopeFactory.CreateScope();

            var service = scope.ServiceProvider
                .GetRequiredService<IEmailNotificationService>();

            await service.SendTestAsync(emailSettings, currentPassword);

            successMessage = "Test email sent successfully. Check your inbox.";
        }
        catch (Exception ex)
        {
            saveErrorMessage = $"Unable to send test email: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
