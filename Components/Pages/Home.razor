@page "/"
@using DotNetCorePatchNotifier.Models
@using DotNetCorePatchNotifier.Services
@inject IPatchCheckService PatchCheckService

<h3>DotNetCorePatchNotifier</h3>

<p>Installed .NET runtimes and available patches</p>

<button class="btn btn-primary mb-3"
        @onclick="CheckPatchesAsync"
        disabled="@isLoading">
    @(isLoading ? "Checking..." : "Check for patches")
</button>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (statuses.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Runtime</th>
                <th>Installed</th>
                <th>Latest</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var runtime in statuses)
            {
                <tr>
                    <td>@runtime.Name</td>
                    <td>@runtime.InstalledVersion</td>
                    <td>@runtime.LatestVersion</td>
                    <td>
                        @if (runtime.UpdateAvailable)
                        {
                            <span class="text-warning fw-bold">
                                Update available
                            </span>
                        }
                        else
                        {
                            <span class="text-success">
                                Up to date
                            </span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-2"
                                @onclick="() => OpenUrlAsync(runtime.DownloadUrl)">
                            Download
                        </button>

                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => OpenUrlAsync(runtime.ReleaseNotesUrl)">
                            View fixes
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RuntimePatchStatus> statuses = new();
    private bool isLoading;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await CheckPatchesAsync();
    }

    private async Task CheckPatchesAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            statuses = await PatchCheckService.CheckAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenUrlAsync(string url)
    {
        try
        {
            await Launcher.Default.OpenAsync(url);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
